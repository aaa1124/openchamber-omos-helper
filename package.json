{
  "name": "openchamber-omos-helper",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Edit oh-my-opencode-slim presets \u2014 per-agent model, variant and skills \u2014 from OpenChamber",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "contributes": {
      "capabilities": ["sessions"],
      "panel": {
        "id": "openchamber-omos-helper",
        "name": "openchamber-omos-helper",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Agent presets",
        "height": 160
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": []
        }
      }
    }
  },
  "scripts": {
    "build": "bun run build:panel && bun run build:status && bun run build:service",
    "build:panel": "bun node_modules/@openchamber/sdk/scripts/bundle-guest.ts panel/main.ts panel/main.js",
    "build:status": "bun node_modules/@openchamber/sdk/scripts/bundle-guest.ts status/main.ts status/main.js",
    "build:service": "bun node_modules/@openchamber/sdk/scripts/bundle-guest.ts --node service/main.ts service/main.js",
    "check": "bun node_modules/@openchamber/sdk/scripts/check-guest.ts ."
  },
  "devDependencies": {
    "@openchamber/sdk": "2.7.1"
  }
}
